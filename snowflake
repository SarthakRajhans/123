-- 8. Execute Analysis Query
SELECT
    C.Customer_Name,
    P.Product_Name,
    CA.Category_Name,
    S.State_Name,
    T.Month,
    F.Quantity,
    F.Total_Amount
FROM Sales_Fact F
JOIN Product P ON F.Product_ID = P.Product_ID
JOIN Category CA ON P.Category_ID = CA.Category_ID
JOIN Customer C ON F.Customer_ID = C.Customer_ID
JOIN State S ON C.State_ID = S.State_ID
JOIN Time_Dim T ON F.Time_ID = T.Time_ID;

